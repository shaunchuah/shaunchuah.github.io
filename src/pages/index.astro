---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import profile from '../assets/profile.jpg';
import ProjectCard from '../components/ProjectCard.astro';
import Publication from '../components/Publication.astro';
import Talk from '../components/Talk.astro';
import YearGroups from '../components/YearGroups.astro';
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/content';

const posts = await getPosts();
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
const selected = (await getCollection('publications'))
  .filter((p) => p.data.selected)
  .sort((a, b) => a.data.order - b.data.order);
const talks = (await getCollection('talks')).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <section class="hero row">
    <div class="label hero-byline">
      <Image src={profile} alt="Shaun Chuah" width={192} height={192} loading="eager" />
      <p class="quals"><span class="byline-name">Shaun Chuah</span>MBChB MRCP(UK)<br />ESEGH MD</p>
    </div>
    <div class="main">
      <h1 class="hero-title">IBD gastro&shy;enterologist.<br /><span>AI engineer.</span></h1>
      <p class="hero-lede">
        Clinical academic at the University of Glasgow. I work on inflammatory bowel disease, clinical data
        infrastructure and applied AI, and build the software our research runs on.
      </p>
    </div>
  </section>

  <section class="section row" aria-labelledby="writing">
    <h2 class="section-title label" id="writing"><span class="index">01</span>Writing</h2>
    <div class="main">
      <YearGroups posts={posts} />
    </div>
  </section>

  <section class="section row" aria-labelledby="projects">
    <h2 class="section-title label" id="projects"><span class="index">02</span>Projects</h2>
    <div class="main">
      <div class="project-cards">
        {featured.map((project, i) => <ProjectCard project={project} index={`2.${i + 1}`} />)}
      </div>
      <div class="project-list">
        {
          others.map((project) => (
            <a href={project.data.url} target="_blank" rel="noopener">
              <span class="name">{project.data.title}</span>
              <span class="muted">{project.data.summary}</span>
            </a>
          ))
        }
      </div>
      <a class="more-link" href="/projects/">More about these projects →</a>
    </div>
  </section>

  <section class="section row" aria-labelledby="publications">
    <h2 class="section-title label" id="publications"><span class="index">03</span>Publications</h2>
    <div class="main">
      {selected.map((pub) => <Publication pub={pub} short />)}
      <a class="more-link" href="/publications/">All publications →</a>
    </div>
  </section>

  <section class="section row" aria-labelledby="talks">
    <h2 class="section-title label" id="talks"><span class="index">04</span>Invited talks</h2>
    <div class="main">
      {talks.slice(0, 3).map((talk) => <Talk talk={talk} />)}
      <a class="more-link" href="/talks/">All invited talks →</a>
    </div>
  </section>
</Base>
