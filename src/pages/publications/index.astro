---
import { getCollection } from 'astro:content';
import Publication from '../../components/Publication.astro';
import YearGroup from '../../components/YearGroup.astro';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../consts';
import { groupByYear } from '../../lib/content';

const pubs = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Publications" description="Peer-reviewed publications and preprints by Shaun Chuah.">
  <section class="page-head row">
    <div class="label"></div>
    <div class="main">
      <h1 class="page-title">Publications</h1>
    </div>
  </section>

  <section class="section row" aria-label="All publications">
    <div class="label"></div>
    <div class="main">
      <div>
        {
          groupByYear(pubs, (pub) => pub.data.year).map(({ year, items }) => (
            <YearGroup year={year}>
              {items.map((pub) => (
                <Publication pub={pub} />
              ))}
            </YearGroup>
          ))
        }
      </div>
      <a class="more-link" href={SITE.orcid}>Full record on ORCID →</a>
    </div>
  </section>
</Base>
