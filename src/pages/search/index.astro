---
import Base from '../../layouts/Base.astro';
---

<Base title="Search" description="Search posts, projects and publications.">
  <section class="page-head row">
    <div class="label"></div>
    <div class="main">
      <h1 class="page-title">Search</h1>
    </div>
  </section>

  <section class="section row" aria-label="Search">
    <div class="label"></div>
    <div class="main">
      <div id="search"></div>
      <noscript>Search needs JavaScript. You can browse <a href="/posts/">all writing</a> instead.</noscript>
    </div>
  </section>
</Base>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    // PagefindUI is only present after a production build (npm run build).
    if (!window.PagefindUI) {
      document.getElementById('search').textContent = 'Search is available after running npm run build.';
      return;
    }
    new window.PagefindUI({ element: '#search', showSubResults: true, showImages: false, autofocus: true });
  });
</script>

<style is:global>
  #search {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--red);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--ink);
    --pagefind-ui-tag: var(--paper-2);
    --pagefind-ui-border-width: 2px;
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-font: var(--font-sans);
  }
</style>
