---
import { getCollection } from 'astro:content';
import Talk from '../../components/Talk.astro';
import YearGroup from '../../components/YearGroup.astro';
import Base from '../../layouts/Base.astro';
import { groupByYear } from '../../lib/content';

const talks = (await getCollection('talks')).sort((a, b) => a.data.order - b.data.order);

const bio =
  'Dr Shaun Chuah is a Clinical Senior Research Fellow at the University of Glasgow and Honorary Consultant Gastroenterologist at NHS Greater Glasgow and Clyde, specialising in inflammatory bowel disease. His MD at the University of Edinburgh studied circulating cell-free DNA as a biomarker in IBD. He now builds AI and data tools for clinical care and research. He co-founded ChatIBD (chatibd.com), an AI guideline assistant for IBD clinicians, and leads development of Foundry120 (foundry120.com), a governed research data platform for translational science. Foundry120 grew out of the sample tracker he built for the MUSIC study and has tracked more than 30,000 samples.';
const shortBio =
  'Dr Shaun Chuah is an IBD consultant and clinical academic at the University of Glasgow who builds AI and data tools for clinical care and research, including ChatIBD and Foundry120.';
---

<Base title="Talks & media" description="Talks, podcasts and videos by Shaun Chuah, with a speaker bio and headshot for event organisers.">
  <section class="page-head row">
    <div class="label"></div>
    <div class="main">
      <h1 class="page-title">Talks &amp; media</h1>
    </div>
  </section>

  <section class="section row" aria-label="All talks and media">
    <div class="label"></div>
    <div class="main">
      <div>
        {
          groupByYear(talks, (talk) => talk.data.year).map(({ year, items }) => (
            <YearGroup year={year}>
              {items.map((talk) => (
                <Talk talk={talk} />
              ))}
            </YearGroup>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section row" aria-labelledby="bio">
    <h2 class="section-title label" id="bio">Speaker bio</h2>
    <div class="main bio">
      <p>{bio}</p>
      <h3 class="bio-label">Short version</h3>
      <p>{shortBio}</p>
      <a class="more-link" href="/shaun-chuah-headshot.jpg" download>Download headshot (JPG, 2122 × 2122 px) →</a>
    </div>
  </section>
</Base>
