---
import YearGroups from '../../components/YearGroups.astro';
import { SITE } from '../../consts';
import Base from '../../layouts/Base.astro';
import { getPosts, getTags, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const tags = getTags(await getPosts());
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { label: tag.label, posts: tag.posts } }));
}

interface Props {
  label: string;
  posts: Post[];
}

const { label, posts } = Astro.props;

// Name as many post titles as fit in a search-result snippet (about 160 characters), at least one.
const lead = `${posts.length} ${posts.length === 1 ? 'post' : 'posts'} by ${SITE.author} on ${label}`;
const quoted = posts.map((post) => `“${post.data.title}”`);
const list = (items: string[]) => (items.length > 1 ? `${items.slice(0, -1).join(', ')} and ${items.at(-1)}` : items[0]);
let shown = 1;
while (shown < quoted.length && `${lead}, including ${list(quoted.slice(0, shown + 1))}.`.length <= 160) shown++;
const description = `${lead}${shown < posts.length ? ', including ' : ': '}${list(quoted.slice(0, shown))}.`;
---

<Base title={`Tagged ${label}`} description={description}>
  <section class="page-head row">
    <div class="label post-meta">
      <a class="index" href="/posts/">← All writing</a>
    </div>
    <div class="main">
      <h1 class="page-title">{label}</h1>
      <p class="page-lede">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    </div>
  </section>

  <section class="section row" aria-label="Posts">
    <div class="label"></div>
    <div class="main">
      <YearGroups posts={posts} compactFrom={Infinity} />
    </div>
  </section>
</Base>
