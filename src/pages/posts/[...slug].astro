---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  excerpt,
  getPosts,
  longDate,
  monthYear,
  type Post,
  postUrl,
  readingMinutes,
  tagSlug,
} from '../../lib/content';
import { postSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, date, updated, tags } = post.data;
const contents = headings.filter((h) => h.depth === 2);
---

<Base
  title={title}
  description={excerpt(post)}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
  editPath={`src/content/posts/${post.id}.md`}
  schema={postSchema(post)}
  markdownPath={`/posts/${post.id}.md`}
>
  <article>
    <header class="post-head row">
      <div class="label post-meta">
        <time datetime={date.toISOString()}>{longDate(date)}</time>
        {
          updated && (
            <span class="muted">
              Updated <time datetime={updated.toISOString()}>{longDate(updated)}</time>
            </span>
          )
        }
        <span class="muted">{readingMinutes(post.body)} min read</span>
      </div>
      <div class="main">
        <h1 class="post-title">{title}</h1>
      </div>
    </header>

    <div class="section row" style="padding-bottom: 0">
      <aside class="label post-aside">
        {
          contents.length > 1 && (
            <nav aria-labelledby="contents-title">
              <span class="aside-title" id="contents-title">Contents</span>
              <ol class="toc">
                {contents.map((heading, i) => (
                  <li>
                    <a href={`#${heading.slug}`}>
                      <span class="index">{i + 1}</span>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        {
          tags.length > 0 && (
            <div>
              <span class="aside-title">Filed under</span>
              <div class="tag-list">
                {tags.map((tag) => (
                  <a href={`/tags/${tagSlug(tag)}/`}>{tag}</a>
                ))}
              </div>
            </div>
          )
        }
      </aside>
      <div class="main prose">
        <Content />
      </div>
    </div>
  </article>

  <nav class="post-nav row" aria-label="More writing">
    <div class="label section-title">More writing</div>
    <div class="main">
      {
        older && (
          <a href={postUrl(older)}>
            <span class="dir">Previous · {monthYear(older.data.date)}</span>
            <span class="title">{older.data.title}</span>
          </a>
        )
      }
      {
        newer ? (
          <a href={postUrl(newer)}>
            <span class="dir">Next · {monthYear(newer.data.date)}</span>
            <span class="title">{newer.data.title}</span>
          </a>
        ) : (
          <a href="/posts/">
            <span class="dir">Back to</span>
            <span class="title">All writing</span>
          </a>
        )
      }
    </div>
  </nav>
</Base>
