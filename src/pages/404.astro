---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" noindex>
  <section class="page-head row not-found">
    <div class="label"><span class="index">404</span></div>
    <div class="main">
      <h1 class="page-title">This page doesn't exist.</h1>
      <p class="page-lede">It may have moved when the site was rebuilt. Try <a href="/posts/" style="text-decoration: underline">all writing</a> or <a href="/projects/" style="text-decoration: underline">projects</a>.</p>
    </div>
  </section>
</Base>
