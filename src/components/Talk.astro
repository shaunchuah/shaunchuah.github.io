---
import type { CollectionEntry } from 'astro:content';

interface Props {
  talk: CollectionEntry<'talks'>;
}

const { title, event, note, kind, url } = Astro.props.talk.data;
const Tag = url ? 'a' : 'div';
---

<Tag class="pub" {...url && { href: url, target: '_blank', rel: 'noopener' }}>
  <span class="pub-title">{title}</span>
  <span class="pub-meta">
    {kind && <span class="kind">{kind}</span>}
    {kind && ' · '}
    {event}
    {note && ` · ${note}`}
  </span>
</Tag>
