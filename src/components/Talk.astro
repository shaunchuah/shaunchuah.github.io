---
import type { CollectionEntry } from 'astro:content';

interface Props {
  talk: CollectionEntry<'talks'>;
}

const { title, event, note } = Astro.props.talk.data;
---

<div class="pub">
  <span class="pub-title">{title}</span>
  <span class="pub-meta">
    {event}
    {note && ` · ${note}`}
  </span>
</div>
