---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: string;
}

const { project, index } = Astro.props;
const { title, url, urlLabel, image, summary, role } = project.data;
---

<a class="project-card" href={url}>
  {image && <Image src={image} alt={`${title} screenshot`} widths={[600, 1000]} sizes="(max-width: 720px) 100vw, 420px" />}
  <span class="body">
    <span class="index">{index}</span>
    <span class="name">{title}</span>
    <span class="summary">{summary}</span>
    <span class="role">{role} · {urlLabel}</span>
  </span>
</a>
