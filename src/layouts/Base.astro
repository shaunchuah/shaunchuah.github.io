---
import '../styles/global.css';
import { Font } from 'astro:assets';
import profile from '../assets/profile.jpg';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../consts';
import { ogImagePath } from '../lib/og';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  editPath?: string;
  noindex?: boolean;
  /** JSON-LD structured data for this page. */
  schema?: object;
  /** Plain Markdown copy of this page, for AI agents. */
  markdownPath?: string;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedTime,
  modifiedTime,
  editPath,
  noindex = false,
  schema,
  markdownPath,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Every indexed page has a generated 1200 x 630 card (see src/lib/og.ts); the 404 page falls back to the photo.
const ogImage = new URL(noindex ? profile.src : ogImagePath(Astro.url.pathname), Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href="/favicon/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/index.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title ?? pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {
      !noindex && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content={noindex ? 'summary' : 'summary_large_image'} />
    <meta name="twitter:creator" content="@drshaunchuah" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="wrap">
      <Header />
      <main id="content">
        <slot />
      </main>
      <Footer editPath={editPath} />
    </div>
  </body>
</html>
